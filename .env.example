# WayGo Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Secrets
JWT_SECRET=waygo_super_secure_jwt_secret_key_2026_dev_mode_chennai
OTP_SECRET=waygo_super_secure_otp_secret_key_2026_dev_mode_chennai

# Database Connection (SQLite)
DATABASE_URL="file:../prisma/dev.db"

# SMTP Email Configuration (Optional - falls back to Dev Console OTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=waygo_notifications@example.com
SMTP_PASS=secret_smtp_password
SMTP_FROM="WayGo Chennai <no-reply@waygo.app>"

# Twilio SMS Configuration (Global Provider)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Fast2SMS Configuration (Instant Indian Mobile SMS Gateway)
# Sign up at https://www.fast2sms.com to get your instant free API Key
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
